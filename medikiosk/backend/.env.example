# MediKiosk SMS Gateway & OTP Configuration
# Gateway options: "2factor", "textbee", "fast2sms", "twilio", or "auto"
SMS_GATEWAY_PROVIDER=auto

# 2Factor.in Configuration (Free/Low-Cost Instant OTP for Any Indian Number - No Phone Pre-Registration Needed!)
TWOFACTOR_API_KEY=your_2factor_api_key_here

# Textbee.dev Configuration (Open-Source Free Android SMS Gateway - Uses your own phone as SMS dispatch gateway!)
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_textbee_device_id_here

# Fast2SMS Configuration (India Route)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio Configuration (International Route)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here
TWILIO_PHONE_NUMBER=+1234567890

# OTP Expiry & Security
OTP_EXPIRY_SECONDS=300

# Government of India MeitY Bhashini AI Gateway Configuration
# National Language Translation Mission (NLTM)
BHASHINI_API_KEY=your_bhashini_ulca_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_INFERENCE_KEY=your_bhashini_inference_key_here
BHASHINI_PIPELINE_ID=64392f96daac500b55c543d6
